def activate_donate_service(db_conn, user_id, service_key, admin_id):
    """Активация донат услуги администратором"""
    cursor = db_conn.cursor()
    
    if service_key not in DONATE_SERVICES:
        return {'success': False, 'error': 'Услуга не найдена!'}
    
    service = DONATE_SERVICES[service_key]
    
    try:
        if service['type'] == 'farm_access':
            # Активация доступа к донатной ферме
            if service['farm_id'] == 1:
                cursor.execute('''
                    INSERT OR REPLACE INTO donate_farm_access 
                    (user_id, has_farm_1_access, farm_1_banned)
                    VALUES (?, 1, 0)
                ''', (user_id,))
            elif service['farm_id'] == 2:
                cursor.execute('''
                    INSERT OR REPLACE INTO donate_farm_access 
                    (user_id, has_farm_2_access, farm_2_banned)
                    VALUES (?, 1, 0)
                ''', (user_id,))
            
            action_type = f'activate_farm_{service["farm_id"]}'
            
        elif service['type'] == 'farm_limit':
            # Активация лимита x2
            cursor.execute('''
                UPDATE mining_farms 
                SET has_limit_x2 = 1, farm_limit = farm_limit * 2
                WHERE user_id = ?
            ''', (user_id,))
            
            action_type = 'activate_limit_x2'
            
        elif service['type'] == 'info_access':
            # Активация доступа к /инфа (навсегда)
            cursor.execute('''
                INSERT OR REPLACE INTO info_access 
                (user_id, has_info_access, granted_by, granted_at)
                VALUES (?, 1, ?, ?)
            ''', (user_id, admin_id, datetime.now().isoformat()))
            
            action_type = 'activate_info_access'
            
        elif service['type'] == 'dumbbell':
            # Выдача максимальной гантели
            cursor.execute('''
                UPDATE players 
                SET dumbbell_level = 20, 
                    dumbbell_name = 'Гантеля 35кг'
                WHERE user_id = ?
            ''', (user_id,))
            
            action_type = 'activate_max_dumbbell'
            
        elif service['type'] == 'coins':
            # Выдача монет
            amount = service['amount']
            cursor.execute('UPDATE players SET balance = balance + ? WHERE user_id = ?', 
                         (amount, user_id))
            
            cursor.execute('''
                INSERT INTO transactions (user_id, type, amount, description, admin_id)
                VALUES (?, ?, ?, ?, ?)
            ''', (user_id, 'donate_coins', amount, f'Донат: {service["name"]}', admin_id))
            
            action_type = 'activate_coins'
            
        elif service['type'] == 'magnesia':
            # Выдача магнезии
            amount = service['amount']
            cursor.execute('UPDATE players SET magnesia = magnesia + ? WHERE user_id = ?', 
                         (amount, user_id))
            
            cursor.execute('''
                INSERT INTO admin_actions (admin_id, action_type, target_user_id, details)
                VALUES (?, ?, ?, ?)
            ''', (admin_id, 'add_magnesia', user_id, f'Донат: {service["name"]} - {amount} банок'))
            
            action_type = 'activate_magnesia'
        
        else:
            return {'success': False, 'error': 'Неизвестный тип услуги!'}
        
        # Логируем активацию
        cursor.execute('''
            INSERT INTO admin_actions (admin_id, action_type, target_user_id, details)
            VALUES (?, ?, ?, ?)
        ''', (admin_id, action_type, user_id, f'Активирована услуга: {service["name"]} ({service["price_rub"]} руб.)'))
        
        db_conn.commit()
        
        return {
            'success': True,
            'service_name': service['name'],
            'price_rub': service['price_rub'],
            'user_id': user_id
        }
        
    except Exception as e:
        return {'success': False, 'error': f'Ошибка активации: {str(e)}'}

