async def get_top_business_players(limit: int = 10, sort_by: str = "business_count"):
    """Получить топ игроков по бизнесам"""
    players = await db.players.find({}).to_list(None)
    
    # Рассчитываем метрики для каждого игрока
    player_metrics = []
    for player in players:
        business_count = 0
        total_hourly_income = 0
        
        for business_id in settings.BUSINESSES:
            business_level = player.get(f"business_{business_id}_level", 0)
            if business_level > 0:
                business_count += 1
                business = settings.BUSINESSES[business_id]
                income = business["base_income"] + (business_level - 1) * business["income_increase"]
                total_hourly_income += income
        
        player_metrics.append({
            "user_id": player["user_id"],
            "username": player["username"],
            "business_count": business_count,
            "total_hourly_income": total_hourly_income,
            "balance": player.get("balance", 0)
        })
    
    # Сортируем по выбранному параметру
    if sort_by == "business_count":
        player_metrics.sort(key=lambda x: x["business_count"], reverse=True)
    elif sort_by == "income":
        player_metrics.sort(key=lambda x: x["total_hourly_income"], reverse=True)
    elif sort_by == "balance":
        player_metrics.sort(key=lambda x: x["balance"], reverse=True)
    
    return player_metrics[:limit]

async def sell_business(user_id: int, business_id: int):
    """Продать бизнес с возвратом 50% стоимости"""
    player = await get_player(user_id)
    
    if not player:
        return {"success": False, "error": "Игрок не найден"}
    
    business_level = player.get(f"business_{business_id}_level", 0)
    if business_level == 0:
        return {"success": False, "error": "Вы не владеете этим бизнесом"}
    
    business = settings.BUSINESSES[business_id]
    
    # Рассчитываем возврат (50% от базовой стоимости)
    refund_amount = business["base_price"] // 2
    
    # Удаляем бизнес у игрока
    await db.players.update_one(
        {"user_id": user_id},
        {
            "$set": {
                f"business_{business_id}_level": 0,
                f"business_{business_id}_upgrades": {},
                f"business_{business_id}_balance": 0,
                f"business_{business_id}_last_collect": None
            }
        }
    )
    
    return {
        "success": True,
        "refund_amount": refund_amount,
        "business_name": business["name"]
    }
