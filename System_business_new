@business_labeler.message(text=["б <business_id> купить", "/б <business_id> купить"])
async def buy_business_handler(message: Message, business_id: str):
    """Покупка бизнеса"""
    try:
        business_id = int(business_id)
    except ValueError:
        return "❌ Номер бизнеса должен быть числом!"

    if business_id not in settings.BUSINESSES:
        return "❌ Бизнес не найден!"

    user_id = message.from_id
    player = await get_player(user_id)

    if not player:
        player = await create_player(user_id, str(message.from_id))

    business = settings.BUSINESSES[business_id]
    business_level = player.get(f"business_{business_id}_level", 0)

    if business_level > 0:
        return "❌ Вы уже владеете этим бизнесом!"

    # Проверка для бизнеса #3 (покупается за силу)
    if business_id == 3:
        if player.get("strength", 0) < business["base_price"]:
            return f"❌ Недостаточно силы! Нужно {format_number(business['base_price'])} 💪"
        
        # Снимаем силу
        await db.players.update_one(
            {"user_id": user_id},
            {"$inc": {"strength": -business["base_price"]}}
        )
    else:
        # Для остальных бизнесов проверяем монеты
        if player["balance"] < business["base_price"]:
            return f"❌ Недостаточно монет! Нужно {format_number(business['base_price'])} 💰"

    await buy_business(user_id, business_id, business)

    # Информация о бонусе клана
    clan = await get_player_clan(user_id)
    clan_bonus_text = ""
    if clan:
        clan_bonuses = get_clan_bonuses(clan['level'])
        clan_bonus_text = f"\n🏰 Бонус клана: +{clan_bonuses['business_bonus_percent']}% в казну клана"
    
    if business_id == 3:
        currency_used = f"{format_number(business['base_price'])} 💪 силы"
    else:
        currency_used = f"{format_number(business['base_price'])} 💰 монет"
    
    return (
        f'🎉 Бизнес куплен!\n\n'
        f'🏢 {business["name"]}\n'
        f'💵 Стоимость: {currency_used}\n'
        f'⏳ Доход: {business["base_income"]} монет в час{clan_bonus_text}'
    )


@business_labeler.message(text=["б продать <business_id>", "/б продать <business_id>"])
async def sell_business_handler_cmd(message: Message, business_id: str):
    """Продажа бизнеса"""
    try:
        business_id = int(business_id)
    except ValueError:
        return "❌ Номер бизнеса должен быть числом!"

    if business_id not in settings.BUSINESSES:
        return "❌ Бизнес не найден!"

    user_id = message.from_id
    player = await get_player(user_id)

    if not player:
        return "❌ Игрок не найден!"

    business_level = player.get(f"business_{business_id}_level", 0)
    if business_level == 0:
        return f"❌ Вы не владеете бизнесом #{business_id}!"

    # Сначала собираем все накопленные доходы
    accumulated = await get_business_income(user_id, business_id)
    if accumulated > 0:
        await collect_business_income(user_id, business_id)

    # Продаем бизнес
    result = await sell_business(user_id, business_id)
    
    if result["success"]:
        refund_amount = result["refund_amount"]
        business = settings.BUSINESSES[business_id]
        
        # Возвращаем деньги в зависимости от типа бизнеса
        if business_id == 3:
            # Для бизнеса #3 возвращаем силу (50% от стоимости)
            await db.players.update_one(
                {"user_id": user_id},
                {"$inc": {"strength": refund_amount}}
            )
            currency_text = f"{format_number(refund_amount)} 💪 силы"
        else:
            # Для остальных бизнесов возвращаем монеты
            await update_player_balance(
                user_id,
                refund_amount,
                "business_sell",
                f"Продажа бизнеса #{business_id}",
                None,
            )
            currency_text = f"{format_number(refund_amount)} 💰 монет"
        
        return (
            f"🏪 Бизнес продан!\n\n"
            f"🏢 Бизнес: #{business_id} {business['name']}\n"
            f"💰 Возвращено: {currency_text}\n"
            f"📉 Возврат: 50% от стоимости\n\n"
            f"💡 Вы можете купить новый бизнес: /б магазин"
        )
    else:
        return f"❌ {result['error']}"


