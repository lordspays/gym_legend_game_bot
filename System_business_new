@business_labeler.message(text=["б сравнить", "/б сравнить"])
async def compare_businesses_handler(message: Message):
    """Сравнение бизнесов"""
    user_id = message.from_id
    player = await get_player(user_id)

    if not player:
        player = await create_player(user_id, str(message.from_id))

    comparison = []
    total_invested = 0
    total_hourly_income = 0
    
    for business_id, business in settings.BUSINESSES.items():
        business_level = player.get(f"business_{business_id}_level", 0)
        
        if business_level > 0:
            # Рассчитываем инвестиции
            base_investment = business["base_price"]
            
            # Добавляем стоимость улучшений
            upgrades = player.get(f"business_{business_id}_upgrades", {})
            upgrade_investment = 0
            
            for i in range(1, 6):
                if upgrades.get(str(i), 0) > 0:
                    upgrade_investment += calculate_upgrade_cost(business_id, i-1)
            
            total_investment = base_investment + upgrade_investment
            total_invested += total_investment
            
            # Рассчитываем доход
            hourly_income = business["base_income"] + (business_level - 1) * business["income_increase"]
            total_hourly_income += hourly_income
            
            # ROI (окупаемость в часах)
            if hourly_income > 0:
                roi_hours = total_investment / hourly_income
                roi_days = roi_hours / 24
            else:
                roi_hours = 0
                roi_days = 0
            
            completed_upgrades = sum(1 for v in upgrades.values() if v > 0)
            
            comparison.append(
                f"#{business_id}. {business['name']}\n"
                f"   📊 Уровень: {business_level}\n"
                f"   🏗️ Улучшено: {completed_upgrades}/5\n"
                f"   💰 Инвестиции: {format_number(total_investment)} {'💪' if business_id == 3 else '💰'}\n"
                f"   ⏳ Доход: {format_number(hourly_income)} монет/час\n"
                f"   📈 Окупаемость: {roi_days:.1f} дней"
            )
    
    if not comparison:
        return "📊 СРАВНЕНИЕ БИЗНЕСОВ\n\nУ вас пока нет бизнесов для сравнения!"
    
    # Сортируем по окупаемости (самые быстрые сверху)
    comparison.sort(key=lambda x: float(x.split("Окупаемость: ")[1].split()[0]))
    
    total_roi = total_invested / total_hourly_income if total_hourly_income > 0 else 0
    total_roi_days = total_roi / 24
    
    info_text = (
        "📊 СРАВНЕНИЕ БИЗНЕСОВ\n\n"
        "🏢 Ваши бизнесы (отсортированы по окупаемости):\n\n"
        + "\n\n".join(comparison)
        + f"\n\n📈 ОБЩАЯ СТАТИСТИКА:\n"
        f"💰 Всего инвестировано: {format_number(total_invested)}\n"
        f"⏳ Общий доход в час: {format_number(total_hourly_income)} монет\n"
        f"📊 Общая окупаемость: {total_roi_days:.1f} дней\n"
        f"💵 Доход в день: {format_number(total_hourly_income * 24)} монет"
    )
    
    return info_text


