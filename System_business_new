@business_labeler.message(text=["б снять <business_id> <amount>", "/б снять <business_id> <amount>"])
async def withdraw_from_business_handler(message: Message, business_id: str, amount: str):
    """Снять деньги с баланса бизнеса"""
    try:
        business_id = int(business_id)
        amount = int(amount)
    except ValueError:
        return "❌ Номер бизнеса и сумма должны быть числами!"
    
    if business_id not in settings.BUSINESSES:
        return "❌ Бизнес не найден!"
    
    if amount <= 0:
        return "❌ Сумма должна быть положительной!"
    
    user_id = message.from_id
    player = await get_player(user_id)
    
    if not player:
        return "❌ Игрок не найден!"
    
    business_level = player.get(f"business_{business_id}_level", 0)
    if business_level == 0:
        return f"❌ Вы не владеете бизнесом #{business_id}!"
    
    # Собираем накопленный доход перед снятием
    await collect_business_income(user_id, business_id)
    
    success, msg = await withdraw_from_business(user_id, business_id, amount)
    
    if success:
        business_balance_key = f"business_{business_id}_balance"
        player = await get_player(user_id)
        current_balance = player.get(business_balance_key, 0)
        
        return (
            f"💰 Деньги сняты с бизнеса!\n\n"
            f"🏢 Бизнес: #{business_id} {settings.BUSINESSES[business_id]['name']}\n"
            f"💸 Снято: {format_number(amount)} монет\n"
            f"🏦 Остаток в бизнесе: {format_number(current_balance)} монет\n"
            f"💳 Ваш баланс: {format_number(player['balance'])} монет"
        )
    else:
        return f"❌ {msg}"


@business_labeler.message(text=["б снять все", "/б снять все"])
