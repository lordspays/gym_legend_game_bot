def calculate_upgrade_cost(business_id: int, completed_upgrades: int):
    """Рассчитать стоимость следующего улучшения"""
    if business_id == 1:
        # Бизнес 1: 50, 100, 150, 200, 250
        upgrade_costs = [50, 100, 150, 200, 250]
        if completed_upgrades >= 5:
            return 0
        return upgrade_costs[completed_upgrades]
    
    elif business_id == 2:
        # Бизнес 2: 500, 550, 600, 650, 700
        upgrade_costs = [500, 550, 600, 650, 700]
        if completed_upgrades >= 5:
            return 0
        return upgrade_costs[completed_upgrades]
    
    elif business_id == 3:
        # Бизнес 3: 300, 360, 420, 480, 540 (за силу)
        upgrade_costs = [300, 360, 420, 480, 540]
        if completed_upgrades >= 5:
            return 0
        return upgrade_costs[completed_upgrades]
    
    else:
        return 0


