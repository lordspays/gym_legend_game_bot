def format_business_info(user_id: int, player: dict, business_id: int, business: dict):
    """Форматирование информации о купленном бизнесе"""
    business_level = player.get(f"business_{business_id}_level", 0)
    upgrades = player.get(f"business_{business_id}_upgrades", {})
    completed_upgrades = sum(1 for v in upgrades.values() if v > 0)
    
    # Базовый доход бизнеса
    base_income = (
        business["base_income"] + (business_level - 1) * business["income_increase"]
    )
    
    # Рассчитываем накопленный доход
    accumulated_income = get_business_income(user_id, business_id)
    business_balance_key = f"business_{business_id}_balance"
    current_balance = player.get(business_balance_key, 0) + accumulated_income
    
    # Время до следующего полного часа
    last_collect_key = f"business_{business_id}_last_collect"
    if last_collect_key in player:
        last_collect = datetime.fromisoformat(player[last_collect_key])
        next_hour = last_collect.replace(minute=0, second=0, microsecond=0)
        next_hour = next_hour.replace(hour=next_hour.hour + 1)
        minutes_left = max(0, int((next_hour - datetime.now()).total_seconds() / 60))
    else:
        minutes_left = 60
    
    # Формируем улучшения
    upgrade_text = ""
    for i in range(1, 6):
        level = upgrades.get(str(i), 0)
        upgrade_info = business["upgrades"][i]
        cost = calculate_upgrade_cost(business_id, completed_upgrades) if level == 0 else "✅"
        
        if business_id == 3:
            cost_text = f"{format_number(cost)} силы" if cost != "✅" else cost
        else:
            cost_text = f"{format_number(cost)} монет" if cost != "✅" else cost
        
        upgrade_text += f"• {i}. {upgrade_info['emoji']} {upgrade_info['name']} (Уровень {level}) - {cost_text}\n"
    
    # Основная информация
    info_parts = [
        f"📊 БИЗНЕС #{business_id} - {business['name']}\n",
        f"⭐ Уровень: {business_level}",
        f"🏗️ Улучшено этапов: {completed_upgrades}/5\n",
        f"💰 ЭКОНОМИКА:",
        f"├─ ⏳ Текущий доход: {format_number(base_income)} монет/час",
        f"├─ 📅 В день: {format_number(base_income * 24)} монет",
        f"├─ 📈 За уровень: +{business['income_increase']} монет/час",
    ]
    
    # Стоимость в правильной валюте
    if business_id == 3:
        info_parts.append(f"└─ 💪 Стоимость: {format_number(business['base_price'])} силы")
    else:
        info_parts.append(f"└─ 💰 Стоимость: {format_number(business['base_price'])} монет")
    
    info_parts.extend([
        "",
        f"🔧 УЛУЧШЕНИЯ:",
        upgrade_text,
        f"💼 БАЛАНС:",
        f"├─ 🏦 В бизнесе: {format_number(current_balance)} монет",
        f"├─ 🕐 Накоплено: {format_number(accumulated_income)} монет",
        f"├─ ⏱️ До сбора: {minutes_left} минут",
        f"└─ 💳 Ваш баланс: {format_number(player['balance'])} монет",
    ])
    
    # Информация о клане
    clan = get_player_clan(user_id)
    if clan:
        clan_bonuses = get_clan_bonuses(clan["level"])
        clan_income = base_income * clan_bonuses["business_bonus_percent"] / 100
        
        info_parts.extend([
            "",
            f"🏰 КЛАН:",
            f"├─ 🏰 Название: [{clan['tag']}] {clan['name']}",
            f"├─ ⭐ Уровень клана: {clan['level']}",
            f"├─ 📊 Бонус клана: +{clan_bonuses['business_bonus_percent']}% в казну",
            f"├─ 👤 Ваш доход: {format_number(base_income)} монет/час",
            f"└─ 🏦 В казну клана: {format_number(clan_income)} монет/час",
        ])
    
    return "\n".join(info_parts)


