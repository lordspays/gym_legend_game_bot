@business_labeler.message(text=["б <cmd_args>", "/б <cmd_args>"])
async def upgrade_business_handler(message: Message, cmd_args: str):
    """Улучшение бизнеса или улучшение всех этапов"""
    parts = cmd_args.strip().split()
    
    if len(parts) < 2:
        return "❌ Формат: /б [номер] [1-5/ВСЕ]"
    
    try:
        business_id = int(parts[0])
        upgrade_option = parts[1].upper()
    except ValueError:
        return "❌ Номер бизнеса должен быть числом!"
    
    if business_id not in settings.BUSINESSES:
        return "❌ Бизнес не найден!"
    
    # Режим "ВСЕ"
    if upgrade_option == "ВСЕ":
        return await upgrade_business_all_handler(message, cmd_args)
    
    # Обычное улучшение
    try:
        upgrade_num = int(upgrade_option)
        if upgrade_num < 1 or upgrade_num > 5:
            return "❌ Номер улучшения должен быть от 1 до 5 или 'ВСЕ'!"
    except ValueError:
        return "❌ Номер улучшения должен быть числом от 1 до 5 или 'ВСЕ'!"
    
    return await upgrade_business_single_handler(message, business_id, upgrade_num)


async def upgrade_business_single_handler(message: Message, business_id: int, upgrade_num: int):
    """Улучшение одного этапа бизнеса"""
    user_id = message.from_id
    player = await get_player(user_id)

    if not player:
        player = await create_player(user_id, str(message.from_id))

    business = settings.BUSINESSES[business_id]
    business_level = player.get(f"business_{business_id}_level", 0)

    if business_level == 0:
        return "❌ Вы не владеете этим бизнесом!"

    upgrades = player.get(f"business_{business_id}_upgrades", {})
    completed_upgrades = sum(1 for v in upgrades.values() if v > 0)
    
    if upgrades.get(str(upgrade_num), 0) > 0:
        return f"❌ Улучшение #{upgrade_num} уже выполнено!"

    # Расчет стоимости улучшения
    upgrade_cost = calculate_upgrade_cost(business_id, completed_upgrades)
    
    if upgrade_cost == 0:
        return "❌ Все улучшения уже выполнены!"

    # Проверка валюты
    if business["upgrade_currency"] == "монет":
        if player["balance"] < upgrade_cost:
            return f"❌ Недостаточно монет! Нужно {format_number(upgrade_cost)} 💰"
    else:
        if player.get("strength", 0) < upgrade_cost:
            return f"❌ Недостаточно силы! Нужно {format_number(upgrade_cost)} 💪"

    await upgrade_business(user_id, business_id, upgrade_num, upgrade_cost)

    upgrade_info = business["upgrades"][upgrade_num]
    
    message_text = (
        f"{upgrade_info['emoji']} Улучшение #{upgrade_num} завершено!\n\n"
        f"✅ {upgrade_info['name']}\n"
        f"💰 Потрачено: {format_number(upgrade_cost)} {business['upgrade_currency']}\n"
        f"🏗️ Улучшено этапов: {completed_upgrades + 1}/5\n"
        f"🏢 Уровень бизнеса: {business_level}"
    )

    if completed_upgrades + 1 >= 5:
        message_text += f"\n\n🎉 ВСЕ 5 УЛУЧШЕНИЙ ЗАВЕРШЕНЫ!\n🏢 Уровень бизнеса повышен до {business_level + 1}\n💰 Доход увеличен до {business['base_income'] + business_level * business['income_increase']} монет/час!"

    return message_text


async def upgrade_business_all_handler(message: Message, cmd_args: str):
    """Улучшение всех доступных этапов бизнеса"""
    parts = cmd_args.strip().split()
    business_id = int(parts[0])
    
    user_id = message.from_id
    player = await get_player(user_id)

    if not player:
        return "❌ Игрок не найден!"

    business = settings.BUSINESSES[business_id]
    business_level = player.get(f"business_{business_id}_level", 0)

    if business_level == 0:
        return "❌ Вы не владеете этим бизнесом!"

    upgrades = player.get(f"business_{business_id}_upgrades", {})
    completed_upgrades = sum(1 for v in upgrades.values() if v > 0)
    
    if completed_upgrades >= 5:
        return "❌ Все улучшения уже выполнены!"
    
    # Определяем сколько этапов можно улучшить
    stages_to_upgrade = 5 - completed_upgrades
    total_cost = 0
    
    # Рассчитываем общую стоимость
    for i in range(completed_upgrades, completed_upgrades + stages_to_upgrade):
        total_cost += calculate_upgrade_cost(business_id, i)
    
    # Проверяем баланс
    if business["upgrade_currency"] == "монет":
        if player["balance"] < total_cost:
            return f"❌ Недостаточно монет! Нужно {format_number(total_cost)} 💰"
    else:
        if player.get("strength", 0) < total_cost:
            return f"❌ Недостаточно силы! Нужно {format_number(total_cost)} 💪"
    
    # Улучшаем все этапы
    current_completed = completed_upgrades
    for stage_num in range(1, 6):
        if upgrades.get(str(stage_num), 0) == 0:
            upgrade_cost = calculate_upgrade_cost(business_id, current_completed)
            await upgrade_business(user_id, business_id, stage_num, upgrade_cost)
            current_completed += 1
    
    # Получаем обновленные данные
    player = await get_player(user_id)
    new_business_level = player.get(f"business_{business_id}_level", 0)
    new_income = business["base_income"] + (new_business_level - 1) * business["income_increase"]
    
    return (
        f"⚡ Все доступные улучшения выполнены!\n\n"
        f"🏢 Бизнес: #{business_id} {business['name']}\n"
        f"🏗️ Улучшено этапов: 5/5\n"
        f"💰 Потрачено: {format_number(total_cost)} {business['upgrade_currency']}\n"
        f"🏢 Новый уровень бизнеса: {new_business_level}\n"
        f"💰 Новый доход: {new_income} монет/час\n\n"
        f"🎉 ВСЕ 5 УЛУЧШЕНИЙ ЗАВЕРШЕНЫ!"
    )


