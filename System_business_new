@business_labeler.message(text=["б", "/б"])
async def show_all_businesses_handler(message: Message):
    """Показать все бизнесы игрока"""
    user_id = message.from_id
    player = await get_player(user_id)

    if not player:
        player = await create_player(user_id, str(message.from_id))

    business_list = []
    total_clan_income = 0
    total_accumulated = 0

    for business_id, business in settings.BUSINESSES.items():
        business_level = player.get(f"business_{business_id}_level", 0)
        if business_level > 0:
            # Автоматически собираем доход при просмотре
            accumulated = await get_business_income(user_id, business_id)
            if accumulated > 0:
                await collect_business_income(user_id, business_id)
                total_accumulated += accumulated
            
            income = (
                business["base_income"]
                + (business_level - 1) * business["income_increase"]
            )
            
            # Получаем текущий баланс
            business_balance_key = f"business_{business_id}_balance"
            balance = player.get(business_balance_key, 0)
            
            business_list.append(
                f"{business_id}. ✅ {business['name']}\n"
                f"   ⏳ Доход: {format_number(income)} монет/час\n"
                f"   💰 Накоплено: {format_number(balance)} монет"
            )
            
            # Рассчитываем доход для клана
            clan = await get_player_clan(user_id)
            if clan:
                clan_bonuses = get_clan_bonuses(clan["level"])
                clan_income = income * clan_bonuses["business_bonus_percent"] / 100
                total_clan_income += clan_income

    if not business_list:
        return "📊 ВАШИ БИЗНЕСЫ\n\nУ вас пока нет бизнесов! 🏢\n\n💡 Посмотреть доступные бизнесы: /б магазин"

    clan_info = ""
    clan = await get_player_clan(user_id)
    if clan:
        clan_info = f"\n🏰 Ваш клан: [{clan['tag']}] {clan['name']}\n💰 В казну клана: ~{format_number(total_clan_income)} монет/час"
    
    collected_info = ""
    if total_accumulated > 0:
        collected_info = f"\n💰 Автоматически собрано: {format_number(total_accumulated)} монет"

    info_text = (
        "📊 ВАШИ БИЗНЕСЫ\n\n"
        "🏢 Купленные бизнесы:\n\n"
        + "\n\n".join(business_list)
        + f"{collected_info}"
        + f"{clan_info}\n\n"
        f"💰 Общий баланс монет: {format_number(player['balance'])} монет\n\n"
        f"📝 Команды:\n"
        f"• /б [номер] - посмотреть бизнес\n"
        f"• /б собрать - собрать доходы\n"
        f"• /б снять все - снять все деньги"
    )

    return info_text


