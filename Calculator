def advanced_eval(expression: str) -> str:
    """
    Расширенное вычисление математических выражений
    """
    expression = expression.strip().lower()
    
    # Убираем лишние пробелы
    expression = re.sub(r'\s+', '', expression)
    
    # Безопасный список операций
    safe_pattern = r'^[\d\+\-\*\/\(\)\.\s]+$'
    
    if not re.match(safe_pattern, expression):
        return "❌ Выражение содержит недопустимые символы"
    
    # Проверка на несколько знаков подряд
    if re.search(r'[\+\-\*\/]{2,}', expression):
        return "❌ Неверный формат выражения"
    
    # Проверка на незакрытые скобки
    if expression.count('(') != expression.count(')'):
        return "❌ Непарные скобки в выражении"
    
    try:
        # Вычисляем
        result = eval(expression)
        
        # Форматируем результат
        if isinstance(result, (int, float)):
            if result == int(result):
                return str(int(result))
            else:
                # Округляем до 2 знаков после запятой
                return f"{result:.2f}".rstrip('0').rstrip('.')
        else:
            return "❌ Результат не является числом"
            
    except ZeroDivisionError:
        return "❌ Деление на ноль невозможно"
    except SyntaxError:
        return "❌ Синтаксическая ошибка"
    except Exception as e:
        return f"❌ Ошибка вычисления"


