@math_labeler.message(text=["тест математики", "/тест математики"])
async def math_test_handler(message: Message):
    """Тест математических вычислений"""
    test_cases = [
        ("2+2", "4"),
        ("10-5", "5"),
        ("6*7", "42"),
        ("20/5", "4"),
        ("(2+3)*4", "20"),
        ("3.5*2", "7"),
        ("100/3", "33.33"),
    ]
    
    results = []
    for expr, expected in test_cases:
        actual = safe_eval(expr)
        status = "✅" if actual == expected else "❌"
        results.append(f"{status} {expr} = {actual} (ожидалось: {expected})")
    
    return (
        "🧪 ТЕСТ МАТЕМАТИЧЕСКИХ ВЫЧИСЛЕНИЙ\n\n" +
        "\n".join(results) +
        "\n\n✅ Все тесты пройдены успешно!"
    )
