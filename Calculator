def safe_eval(expression: str) -> str:
    """
    Безопасное вычисление математического выражения
    """
    # Очищаем выражение от опасных символов
    expression = expression.strip()
    
    # Разрешаем только безопасные математические символы
    safe_chars = set('0123456789+-*/(). ')
    
    if not all(char in safe_chars for char in expression):
        return "❌ Выражение содержит недопустимые символы"
    
    try:
        # Заменяем символы для корректного вычисления
        expr = expression.replace(' ', '')
        
        # Проверяем на деление на ноль
        if '/0' in expr or '/ 0' in expression:
            return "❌ Деление на ноль невозможно"
        
        # Вычисляем выражение
        result = eval(expr, {"__builtins__": {}}, {})
        
        # Проверяем что результат - число
        if isinstance(result, (int, float)):
            # Если результат целый - показываем без .0
            if result == int(result):
                return str(int(result))
            else:
                return str(round(result, 2))
        else:
            return "❌ Неверное математическое выражение"
            
    except ZeroDivisionError:
        return "❌ Деление на ноль"
    except SyntaxError:
        return "❌ Синтаксическая ошибка в выражении"
    except Exception as e:
        return f"❌ Ошибка вычисления: {str(e)}"


