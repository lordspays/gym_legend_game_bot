# ОБРАБОТКА ПРОСТЫХ МАТЕМАТИЧЕСКИХ ВЫРАЖЕНИЙ
# ==============================

@math_labeler.message()
async def auto_math_handler(message: Message):
    """
    Автоматическое распознавание математических выражений в сообщениях
    """
    text = message.text.strip()
    
    # Проверяем, является ли сообщение математическим выражением
    # Безопасный паттерн: начинается с цифры, содержит операторы и цифры
    math_pattern = r'^\s*[\d\(][\d\+\-\*\/\(\)\.\s]+\s*$'
    
    # Игнорируем команды
    if text.startswith('/'):
        return None
    
    # Игнорируем слишком короткие сообщения
    if len(text) < 3:
        return None
    
    # Проверяем паттерн
    if re.match(math_pattern, text):
        # Убираем лишние пробелы
        expression = re.sub(r'\s+', '', text)
        
        # Проверяем что есть хотя бы один оператор
        if any(op in expression for op in '+-*/'):
            result = safe_eval(expression)
            
            if not result.startswith("❌"):
                return f"🧮 Пример: {expression}\n✅ Ответ: {result}"
    
    return None


