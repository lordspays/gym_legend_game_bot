@donate_labeler.message(text=["донат активировать <user> <service>", "/донат активировать <user> <service>"])
async def activate_donate_handler(message: Message, user: str, service: str):
    """Активировать донат услугу для игрока (админ команда)"""
    user_id = message.from_id
    
    # Проверка админ прав (нужно добавить вашу логику проверки)
    # if not await is_admin(user_id):
    #     return "❌ Только администраторы могут активировать донат услуги!"
    
    # Парсим ID пользователя
    target_id = None
    if user.startswith("[id"):
        try:
            target_id = int(user.split("|")[0][3:])
        except:
            pass
    elif user.startswith("@id"):
        try:
            target_id = int(user[3:])
        except:
            pass
    elif user.isdigit():
        target_id = int(user)
    
    if not target_id:
        return "❌ Укажите игрока в формате: @id123, [id123|Имя] или просто ID"
    
    # Проверяем что услуга существует
    if service not in DONATE_SERVICES:
        return f"❌ Услуга '{service}' не найдена!\n💡 Доступные услуги: farm_5, farm_6, limit_x2, info_access, max_dumbbell, coins_35k, power_5k"
    
    donate_service = DONATE_SERVICES[service]
    
    # Получаем информацию об игроке
    target_player = await get_player(target_id)
    if not target_player:
        return f"❌ Игрок с ID {target_id} не найден в системе!"
    
    # Активируем услугу
    result = await activate_donate_service(target_id, service, user_id)
    
    if result["success"]:
        return (
            f"✅ Донат услуга активирована!\n\n"
            f"👤 Игрок: [id{target_id}|{target_player['username']}]\n"
            f"🎁 Услуга: {donate_service['name']}\n"
            f"💰 Стоимость: {donate_service['price_rub']} рублей\n"
            f"👨‍💼 Активировал: [id{user_id}|{await get_player(user_id)['username']}]"
        )
    else:
        return f"❌ Ошибка активации: {result['error']}"


async def activate_donate_service(user_id: int, service_key: str, admin_id: int):
    """Активация донат услуги"""
    if service_key not in DONATE_SERVICES:
        return {"success": False, "error": "Услуга не найдена!"}
    
    service = DONATE_SERVICES[service_key]
    
    try:
        if service['type'] == 'farm_access':
            # Активация доступа к донатной ферме
            if service['farm_id'] == 1:
                await db.donate_farm_access.update_one(
                    {"user_id": user_id},
                    {"$set": {"has_farm_1_access": True, "farm_1_banned": False}},
                    upsert=True
                )
            elif service['farm_id'] == 2:
                await db.donate_farm_access.update_one(
                    {"user_id": user_id},
                    {"$set": {"has_farm_2_access": True, "farm_2_banned": False}},
                    upsert=True
                )
            
            action_type = f'activate_farm_{service["farm_id"]}'
            
        elif service['type'] == 'farm_limit':
            # Активация лимита x2
            await db.mining_farms.update_one(
                {"user_id": user_id},
                {"$set": {"has_limit_x2": True}}
            )
            
            action_type = 'activate_limit_x2'
            
        elif service['type'] == 'info_access':
            # Активация доступа к /инфа
            await db.info_access.update_one(
                {"user_id": user_id},
                {
                    "$set": {
                        "has_info_access": True,
                        "granted_by": admin_id,
                        "granted_at": datetime.now().isoformat()
                    }
                },
                upsert=True
            )
            
            action_type = 'activate_info_access'
            
        elif service['type'] == 'dumbbell':
            # Выдача максимальной гантели
            await db.players.update_one(
                {"user_id": user_id},
                {"$set": {"dumbbell_level": 20, "dumbbell_name": "Гантеля 35кг"}}
            )
            
            action_type = 'activate_max_dumbbell'
            
        elif service['type'] == 'coins':
            # Выдача монет
            amount = service['amount']
            await db.players.update_one(
                {"user_id": user_id},
                {"$inc": {"balance": amount}}
            )
            
            # Логируем транзакцию
            await db.transactions.insert_one({
                "user_id": user_id,
                "type": "donate_coins",
                "amount": amount,
                "description": f"Донат: {service['name']}",
                "admin_id": admin_id,
                "created_at": datetime.now().isoformat()
            })
            
            action_type = 'activate_coins'
            
        elif service['type'] == 'power':
            # Выдача силы
            amount = service['amount']
            await db.players.update_one(
                {"user_id": user_id},
                {"$inc": {"strength": amount}}
            )
            
            # Логируем действие
            await db.admin_actions.insert_one({
                "admin_id": admin_id,
                "action_type": "add_power",
                "target_user_id": user_id,
                "details": f"Донат: {service['name']} - {amount} силы",
                "created_at": datetime.now().isoformat()
            })
            
            action_type = 'activate_power'
        
        else:
            return {"success": False, "error": "Неизвестный тип услуги!"}
        
        # Логируем активацию
        await db.admin_actions.insert_one({
            "admin_id": admin_id,
            "action_type": action_type,
            "target_user_id": user_id,
            "details": f"Активирована донат услуга: {service['name']} ({service['price_rub']} руб.)",
            "created_at": datetime.now().isoformat()
        })
        
        return {
            "success": True,
            "service_name": service['name'],
            "price_rub": service['price_rub'],
            "user_id": user_id
        }
        
    except Exception as e:
        return {"success": False, "error": f"Ошибка активации: {str(e)}"}
